      "source": [
        "# Find Featues with highest correlation with each other\n",
        "corr = X.corr()\n",
        "pairs = (\n",
        "    corr.where(np.triu(np.ones(corr.shape), k=1).astype(bool))\n",
        "    .stack()\n",
        "    .reset_index()\n",
        ")\n",
        "pairs.columns = [\"Feature 1\", \"Feature 2\", \"Correlation\"]\n",
        "pairs[\"abs_corr\"] = pairs[\"Correlation\"].abs()\n",
        "pairs = pairs.sort_values(\"abs_corr\", ascending=False)\n",
        "\n",
        "# Flag any features with correlation > 0.7\n",
        "threshold = 0.7\n",
        "high = pairs[pairs[\"abs_corr\"] >= threshold]\n",
        "if len(high):\n",
        "    print(f\"\\n\\nFeature pairs with |correlation| >= {threshold}:\")\n",
        "    print(high[[\"Feature 1\", \"Feature 2\", \"Correlation\"]].to_string(index=False))\n",
        "else:\n",
        "    print(f\"\\n\\nNo feature pairs found with |correlation| >= {threshold}\")"
      ]
