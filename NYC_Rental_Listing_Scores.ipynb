        "### Model Testing"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "73d63721",
      "metadata": {},
      "source": [
        "Testing both RIDGE and LASSO regression.\n",
        "- RIDGE better off to handle multicolinearity within features\n",
        "- LASSO better to zero out weight coefficient for noisy features"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "85f61ea2",
      "metadata": {},
      "source": [
        "Helper function for running model on both original and feature-aggregated datasets"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 11,
      "id": "33dea560",
      "metadata": {},
      "outputs": [],
      "source": [
        "DATASETS = {\n",
        "    \"v1\": (df,   X,  y),\n",
        "    \"v2\": (dfv2, X2, y2),\n",
        "}\n",
        "\n",
        "RANDOM_STATE = 42\n",
        "TEST_SIZE    = 0.20\n",
        "CV_FOLDS     = 5\n",
        "\n",
        "# Helper function for running model on both original and feature-aggregated datasets\n",
        "def run_model(name, model_type, dataset_key, random_state=RANDOM_STATE):\n",
        "    source_df, X_, y_ = DATASETS[dataset_key]\n",
        "\n",
        "    # GroupShuffleSplit by prevents data leakage where units from the same building appear in both train and test\n",
        "    groups = source_df[\"listing_id\"].str.rsplit(\"_\", n=1).str[0]\n",
        "    gss = GroupShuffleSplit(n_splits=1, test_size=TEST_SIZE, random_state=random_state)\n",
        "    train_idx, test_idx = next(gss.split(X_, y_, groups))\n",
        "\n",
        "    X_train, X_test = X_.iloc[train_idx], X_.iloc[test_idx]\n",
        "    y_train, y_test = y_.iloc[train_idx], y_.iloc[test_idx]\n",
        "    g_train = groups.iloc[train_idx]\n",
        "\n",
        "    if model_type == \"ridge\":\n",
        "        estimator = RidgeCV(alphas=np.logspace(-2, 3, 30))\n",
        "    else:\n",
        "        estimator = LassoCV(alphas=np.logspace(-4, 0, 50), cv=CV_FOLDS, max_iter=10_000)\n",
        "\n",
        "    # Scale feature means & std, standardize to improve model performance\n",
        "    pipe = Pipeline([(\"scaler\", StandardScaler()), (\"model\", estimator)])\n",
        "\n",
        "    # K-Fold Cross Validation to evaluate model performance\n",
        "    cv_scores = cross_val_score(\n",
        "        pipe, X_train, y_train,\n",
        "        groups=g_train,\n",
        "        cv=GroupKFold(n_splits=CV_FOLDS),\n",
        "        scoring=\"r2\", n_jobs=-1,\n",
        "    )\n",
        "\n",
        "    pipe.fit(X_train, y_train)\n",
        "    y_pred   = pipe.predict(X_test)\n",
        "    rent_true = np.exp(y_test)\n",
        "    rent_pred = np.exp(y_pred)\n",
        "\n",
        "    return {\n",
        "        \"name\":       name,\n",
        "        \"pipe\":       pipe,\n",
        "        \"y_test\":     y_test,\n",
        "        \"y_pred\":     y_pred,\n",
        "        \"rent_true\":  rent_true,\n",
        "        \"rent_pred\":  rent_pred,\n",
        "        \"cv_mean\":    cv_scores.mean(),\n",
        "        \"cv_std\":     cv_scores.std(),\n",
        "        \"alpha\":      pipe.named_steps[\"model\"].alpha_,\n",
        "        \"r2\":         r2_score(y_test, y_pred),\n",
        "        \"mae_log\":    mean_absolute_error(y_test, y_pred),\n",
        "        \"mae_dollar\": mean_absolute_error(rent_true, rent_pred),\n",
        "        \"med_pct_err\":(abs(rent_true - rent_pred) / rent_true * 100).median(),\n",
        "        \"n_train\":    len(X_train),\n",
        "        \"n_test\":     len(X_test),\n",
        "    }"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 12,
      "id": "b0efad7a",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Best model: Lasso - Aggregated Features  (Test R²=0.685)\n"
          ]
        }
      ],
      "source": [
        "# Run Ridge & Lasso on both original and feature-aggregated datasets\n",
        "results = {\n",
        "    \"Ridge - Original Features\":  run_model(\"Ridge - Original Features\",  \"ridge\", \"v1\"),\n",
        "    \"Lasso - Original Features\":  run_model(\"Lasso - Original Features\",  \"lasso\", \"v1\"),\n",
        "    \"Ridge - Aggregated Features\":  run_model(\"Ridge - Aggregated Features\",  \"ridge\", \"v2\"),\n",
        "    \"Lasso - Aggregated Features\":  run_model(\"Lasso - Aggregated Features\",  \"lasso\", \"v2\"),\n",
        "}\n",
        "\n",
        "# Save best model by test R²\n",
        "best_key  = max(results, key=lambda k: results[k][\"r2\"])\n",
        "best      = results[best_key]\n",
        "best_pipe = best[\"pipe\"]\n",
        "\n",
        "# Resolve which (df, X, y) the best model used\n",
        "best_dataset_key = \"v2\" if \"v2\" in best_key else \"v1\"\n",
        "best_df, best_X, best_y = DATASETS[best_dataset_key]\n",
        "best_groups = best_df[\"listing_id\"].str.rsplit(\"_\", n=1).str[0]\n",
        "\n",
        "print(f\"Best model: {best_key}  (Test R²={best['r2']:.3f})\")"
      ]
    },
