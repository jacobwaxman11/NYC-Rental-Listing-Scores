        "log_rent_pred_oof = cross_val_predict(\n",
        "    best_pipe, best_X, best_y,\n",
        "    groups=best_groups,\n",
        "    cv=GroupKFold(n_splits=CV_FOLDS),\n",
        ")\n",
        "\n",
        "with sqlite3.connect(\"rentals.db\") as conn:\n",
        "    meta = pd.read_sql(\n",
        "        \"SELECT listing_id, name, neighborhood, beds, sqft, url FROM listings\",\n",
        "        conn,\n",
        "    )\n",
        "\n",
        "deals = (\n",
        "    best_df[[\"listing_id\"]]\n",
        "    .assign(\n",
        "        actual_rent    = np.exp(best_y).round().astype(int).to_numpy(),\n",
        "        predicted_rent = np.exp(log_rent_pred_oof).round().astype(int),\n",
        "    )\n",
        "    .assign(\n",
        "        savings_dollar = lambda d: d[\"predicted_rent\"] - d[\"actual_rent\"],\n",
        "        pct_below_pred = lambda d: (d[\"predicted_rent\"] - d[\"actual_rent\"])\n",
        "                                   / d[\"predicted_rent\"] * 100,\n",
        "    )\n",
        "    .merge(meta, on=\"listing_id\", how=\"left\")\n",
        ")\n",
        "\n",
        "top10 = deals.sort_values(\"pct_below_pred\", ascending=False).head(10)\n",
        "\n",
        "print(f\"Deal scores from best model: {best_key}\\n\")\n",
        "print(top10[\n",
        "    [\"name\", \"neighborhood\", \"beds\", \"sqft\",\n",
        "     \"actual_rent\", \"predicted_rent\", \"savings_dollar\",\n",
        "     \"pct_below_pred\", \"url\"]\n",
        "].round({\"pct_below_pred\": 1}).to_string(index=False))"
      ]
